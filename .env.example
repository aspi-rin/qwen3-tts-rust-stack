# Supported backends: vulkan, cpu.
# Upstream v0.1.6 only publishes a Linux Vulkan release asset.
# CPU mode uses the same binary without GPU passthrough, relying on CPU fallback.
QWEN3_TTS_BACKEND=vulkan

# Optional: override image tag. Leave empty to use the backend default from Makefile.
QWEN3_TTS_IMAGE=

QWEN3_TTS_QUANT=q5_k_m
QWEN3_TTS_SPEAKER=vivian
QWEN3_TTS_OUTPUT=speech.wav
QWEN3_TTS_INPUT=你好，我是本地语音合成服务。
