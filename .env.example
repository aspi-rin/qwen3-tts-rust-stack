# Qwen3-TTS-Rust stack runtime configuration
# Supported compose backends: cpu, vulkan.
# Upstream v0.1.6 only publishes a Linux Vulkan release asset.
# - QWEN3_TTS_BACKEND=vulkan: pass /dev/dri through to the container.
# - QWEN3_TTS_BACKEND=cpu: use the same Linux Vulkan binary without GPU passthrough, relying on CPU fallback.
QWEN3_TTS_BACKEND=vulkan
QWEN3_TTS_IMAGE=
QWEN3_TTS_MODEL_DIR=/app/models
QWEN3_TTS_SPEAKERS_DIR=/app/speakers
QWEN3_TTS_QUANT=q5_k_m
QWEN3_TTS_SPEAKER=vivian
QWEN3_TTS_OUTPUT=speech.wav
QWEN3_TTS_INPUT=你好，我是本地语音合成服务。
