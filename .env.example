# Supported backends: vulkan, cuda, cpu.
# Vulkan and CPU share the upstream Linux Vulkan runtime bundle.
# CUDA uses a separate source-built runtime image.
QWEN3_TTS_BACKEND=vulkan

QWEN3_TTS_QUANT=q5_k_m

# Set to 1/true/on to keep verbose upstream debug logs. Default filters noisy per-token/tensor debug lines.
QWEN3_TTS_DEBUG_LOGS=0

# Host interface for the public adapter port. Use 0.0.0.0 to expose beyond localhost.
QWEN3_TTS_BIND_HOST=127.0.0.1
# Physical GPU index for GPU-backed compose overrides (vulkan/cuda).
QWEN3_TTS_GPU_DEVICE_ID=0
