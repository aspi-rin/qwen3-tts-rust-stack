# Supported backends: vulkan, cpu.
# Upstream v0.1.6 only publishes a Linux Vulkan runtime bundle.
# CPU mode uses the same runtime bundle without GPU passthrough, relying on CPU fallback.
QWEN3_TTS_BACKEND=vulkan

QWEN3_TTS_QUANT=q5_k_m

# Set to 1/true/on to keep verbose upstream debug logs. Default filters noisy per-token/tensor debug lines.
QWEN3_TTS_DEBUG_LOGS=0
