# Qwen3-TTS-Rust stack runtime configuration
# Supported compose backends: cpu, vulkan, cuda.
# cpu/vulkan are currently backed by the upstream Linux Vulkan release asset.
# cuda is declared for deployment parity, but upstream v0.1.6 has no Linux CUDA Docker/release asset yet.
QWEN3_TTS_BACKEND=vulkan
QWEN3_TTS_IMAGE=
QWEN3_TTS_MODEL_DIR=/app/models
QWEN3_TTS_SPEAKERS_DIR=/app/speakers
QWEN3_TTS_QUANT=q5_k_m
QWEN3_TTS_SPEAKER=vivian
QWEN3_TTS_THREADS=4
QWEN3_TTS_OUTPUT=speech.wav
QWEN3_TTS_INPUT=你好，我是本地语音合成服务。
