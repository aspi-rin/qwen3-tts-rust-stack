{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vex9z7/qwen3-tts-rust-stack/schemas/openai/openai-audio-speech-request.schema.json",
  "title": "OpenAI-compatible Create speech request",
  "description": "Request body schema for POST /v1/audio/speech. The adapter uses the OpenAI Create speech request shape, but model and voice enums are local Qwen3-TTS identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "input",
    "voice"
  ],
  "properties": {
    "input": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "The text to generate audio for."
    },
    "model": {
      "type": "string",
      "enum": [
        "qwen3-tts"
      ],
      "description": "Local Qwen3-TTS model identifier."
    },
    "voice": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ryan",
            "aiden",
            "sohee",
            "eric",
            "uncle_fu",
            "serena",
            "ono_anna",
            "vivian",
            "dylan"
          ],
          "description": "Local Qwen3 speaker name."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Local Qwen3 speaker identifier."
            }
          }
        }
      ],
      "description": "Local Qwen3 speaker to use when generating audio, either as a string or custom voice object shape."
    },
    "instructions": {
      "type": "string",
      "maxLength": 4096,
      "description": "Instructions controlling voice affect, tone, pacing, or other delivery details."
    },
    "response_format": {
      "type": "string",
      "enum": [
        "mp3",
        "opus",
        "aac",
        "flac",
        "wav",
        "pcm"
      ],
      "default": "mp3",
      "description": "Output audio format."
    },
    "speed": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 4.0,
      "default": 1.0,
      "description": "Generated audio speed multiplier."
    },
    "stream_format": {
      "type": "string",
      "enum": [
        "sse",
        "audio"
      ],
      "default": "audio",
      "description": "Streaming response framing. audio returns audio bytes directly; sse returns audio events."
    }
  }
}
