+/// Create CUDA Session on Linux. CUDA backend is intentionally strict: if the
+/// CUDA provider cannot load or commit, startup fails instead of silently
+/// falling back to CPU.
+#[cfg(all(feature = "cuda", target_os = "linux"))]
+fn create_cuda_session(model_path: &str) -> Result<Session, Box<dyn Error>> {
+    println!("  [ONNX] Requesting Execution Providers: CUDA");
+    let builder = Session::builder()?;
+    let builder = builder.with_optimization_level(GraphOptimizationLevel::Level3)?;
+
+    let cuda = CUDAExecutionProvider::default().build();
+    let builder = builder.with_execution_providers([cuda])?;
+    println!("  [ONNX] CUDA Provider configured.");
+
+    let session = builder.commit_from_file(model_path)?;
+    println!("  [ONNX] CUDA Session committed.");
+    Ok(session)
+}
