 use std::io::{Read, Seek};
 
+// Q8_0: 32 int8 weights per block, prefixed by one f16 scale value.
+const QK8_0: usize = 32;
+
+fn f16_to_f32(h: u16) -> f32 {
+    let s = (h >> 15) as u32;
+    let e = ((h >> 10) & 0x1f) as i32;
+    let m = (h & 0x3ff) as u32;
+    match e {
+        0 if m == 0 => f32::from_bits(s << 31),
+        0 => f32::from_bits((s << 31) | ((127u32 - 14) << 23) | (m << 13)),
+        31 if m == 0 => f32::from_bits((s << 31) | 0x7f80_0000),
+        31 => f32::NAN,
+        _ => f32::from_bits((s << 31) | ((e as u32 + 127 - 15) << 23) | (m << 13)),
+    }
+}
+
+fn dequantize_q8_0(raw: &[u8], num_elems: usize) -> Vec<f32> {
+    let num_blocks = (num_elems + QK8_0 - 1) / QK8_0;
+    let mut out = Vec::with_capacity(num_elems);
+    for b in 0..num_blocks {
+        let base = b * (2 + QK8_0);
+        let scale = f16_to_f32(u16::from_le_bytes([raw[base], raw[base + 1]]));
+        let elems = QK8_0.min(num_elems - b * QK8_0);
+        for i in 0..elems {
+            out.push(raw[base + 2 + i] as i8 as f32 * scale);
+        }
+    }
+    out
+}
